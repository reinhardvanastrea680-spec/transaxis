# ---- Supabase (required) ----
# Project URL and anon key from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Site URL (required for OAuth) ----
# The canonical public origin of this app. Supabase validates the OAuth
# `redirectTo` against its Redirect URL allowlist; if this origin is missing
# from that allowlist, Google shows the Supabase project URL instead of yours.
#
# Local development:  http://localhost:3000
# Production:          https://transaxis.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase service role (required for staff admin + POD retention) ----
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Paystack (required for card payments) ----
# Dashboard → Settings → API Keys & Webhooks.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# Plan codes (PLN_xxx) created under Paystack → Products → Plans.
# Optional: without them the checkout is a one-off charge instead of a
# recurring subscription.
PAYSTACK_PLAN_CODE_GROWTH=
PAYSTACK_PLAN_CODE_OPERATIONS=

# ---- Cron (required to protect the retention job) ----
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=generate-a-long-random-string

