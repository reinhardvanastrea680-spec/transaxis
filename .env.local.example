# ---- Supabase (required) ----
# Project URL and anon key from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Site URL (required for OAuth) ----
# The canonical public origin of this app. Used for OAuth redirects and email
# links. It does NOT change what Google prints on the account chooser — that
# line shows the host of the OAuth redirect URI, which is the Supabase project
# URL unless GOOGLE_CLIENT_ID below is set (see docs/GOOGLE_OAUTH.md).
#
# Local development:  http://localhost:3000
# Production:          https://transaxis.com.ng
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Google sign-in on your own domain (optional) ----
# Without these, "Continue with Google" uses Supabase's hosted flow and the
# Google account chooser says "to continue to <project-ref>.supabase.co".
# With them, the callback runs on NEXT_PUBLIC_SITE_URL and Google shows your
# domain instead.
#
# Same OAuth client already configured in Supabase → Authentication →
# Providers → Google. Add this Authorized redirect URI in Google Cloud:
#   https://transaxis.com.ng/api/auth/google/callback
#
# Server-only. Never expose GOOGLE_CLIENT_SECRET to the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Demo video (optional) ----
# Powers the #demo slot on the landing page. Leave unset to show the
# "coming soon" placeholder.
#   Self-hosted file:  https://.../transaxis-demo.mp4   (or /demo/transaxis-demo.mp4)
#   YouTube/Vimeo/Loom share link: https://youtu.be/xxxx  https://vimeo.com/123  https://www.loom.com/share/abc
# Share links are converted to their embed form automatically; an unrecognised
# URL renders as a plain link rather than a broken player.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Optional WebVTT/SRT subtitle track for a self-hosted file, e.g.
#   NEXT_PUBLIC_DEMO_CAPTIONS_URL=/demo/transaxis-demo.vtt
# Ignored for YouTube/Vimeo/Loom, which carry their own captions.
NEXT_PUBLIC_DEMO_CAPTIONS_URL=

# ---- Supabase service role (required for staff admin + POD retention) ----
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Paystack (required for card payments) ----
# Dashboard → Settings → API Keys & Webhooks.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# Recurring plan codes (PLN_xxx), keyed plan:cycle in ONE JSON var:
#   plan   standard | pro | max
#   cycle  monthly | quarterly | annual
# 3 × 3 = 9 codes. Create the matching NGN plans in Paystack (Products →
# Plans) with the amounts from src/lib/plans.ts PRICE_TABLE — or run
# `node scripts/create-paystack-plans.ts <secret-key>` which creates them and
# prints this env var. Optional: a checkout whose key is missing here is a
# one-off charge for the exact listed price instead of a subscription.
PAYSTACK_PLAN_CODES={"standard:monthly":"PLN_xxx","pro:monthly":"PLN_xxx"}

# ---- Cron (required to protect the retention job) ----
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=generate-a-long-random-string

