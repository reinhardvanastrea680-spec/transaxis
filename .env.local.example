# ---- Supabase (required) ----
# Project URL and anon key from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Site URL (required for OAuth) ----
# The canonical public origin of this app. Supabase validates the OAuth
# `redirectTo` against its Redirect URL allowlist; if this origin is missing
# from that allowlist, Google shows the Supabase project URL instead of yours.
#
# Local development:  http://localhost:3000
# Production:          https://transaxis.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
